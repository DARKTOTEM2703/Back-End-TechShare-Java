<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- ============================================ -->
    <!-- PROPERTIES -->
    <!-- ============================================ -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="APP_NAME" value="techshare-backend"/>
    
    <!-- Patterns -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="LOG_PATTERN_COLOR" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%cyan(%thread)] %yellow(%logger{36}) [RequestID: %X{requestId:-NO_REQUEST_ID}] [User: %X{user:-anonymous}] [IP: %X{clientIp:-unknown}] - %msg%n"/>

    <!-- ============================================ -->
    <!-- CONSOLE APPENDER (Development) -->
    <!-- ============================================ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN_COLOR}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    
    <!-- ============================================ -->
    <!-- JSON APPENDER (Production) -->
    <!-- ============================================ -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.json</file>
        
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Rotación diaria -->
            <fileNamePattern>${LOG_PATH}/archived/${APP_NAME}.%d{yyyy-MM-dd}.json.gz</fileNamePattern>
            <!-- Mantener logs de los últimos 30 días -->
            <maxHistory>30</maxHistory>
            <!-- Tamaño máximo total de logs: 1GB -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        
        <!-- Encoder JSON usando Logstash -->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Campos custom adicionales -->
            <customFields>{"application":"${APP_NAME}","environment":"${SPRING_PROFILES_ACTIVE:-dev}"}</customFields>
            
            <!-- Incluir MDC (Mapped Diagnostic Context) -->
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>user</includeMdcKeyName>
            <includeMdcKeyName>clientIp</includeMdcKeyName>
            
            <!-- Incluir stack traces completos -->
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <maxLength>8192</maxLength>
                <shortenedClassNameLength>20</shortenedClassNameLength>
                <exclude>sun\.reflect\..*</exclude>
                <exclude>net\.sf\.cglib\..*</exclude>
                <exclude>org\.springframework\.cglib\..*</exclude>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- ============================================ -->
    <!-- FILE APPENDER (Plain Text Backup) -->
    <!-- ============================================ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/${APP_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ============================================ -->
    <!-- ERROR FILE APPENDER (Solo errores y warnings) -->
    <!-- ============================================ -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-errors.json</file>
        
        <!-- Solo logs de nivel WARN y ERROR -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/${APP_NAME}-errors.%d{yyyy-MM-dd}.json.gz</fileNamePattern>
            <maxHistory>60</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"application":"${APP_NAME}","environment":"${SPRING_PROFILES_ACTIVE:-dev}","logType":"error"}</customFields>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>user</includeMdcKeyName>
            <includeMdcKeyName>clientIp</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ============================================ -->
    <!-- ASYNC APPENDERS (Performance) -->
    <!-- ============================================ -->
    <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="JSON_FILE"/>
    </appender>
    
    <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- ============================================ -->
    <!-- LOGGERS -->
    <!-- ============================================ -->
    
    <!-- Application Loggers -->
    <logger name="com.techmate.techmate" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_JSON"/>
        <appender-ref ref="ASYNC_ERROR"/>
    </logger>
    
    <!-- Spring Framework -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="DEBUG"/>
    <logger name="org.springframework.security" level="DEBUG"/>
    <logger name="org.springframework.boot.autoconfigure" level="WARN"/>
    
    <!-- Hibernate/JPA -->
    <logger name="org.hibernate" level="INFO"/>
    <logger name="org.hibernate.SQL" level="DEBUG"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>
    <logger name="org.hibernate.stat" level="DEBUG"/>
    
    <!-- HikariCP -->
    <logger name="com.zaxxer.hikari" level="INFO"/>
    
    <!-- Flyway -->
    <logger name="org.flyway" level="INFO"/>
    
    <!-- Redis -->
    <logger name="io.lettuce.core" level="INFO"/>
    <logger name="org.springframework.data.redis" level="DEBUG"/>
    
    <!-- Suprimir logs innecesarios -->
    <logger name="org.apache.catalina" level="WARN"/>
    <logger name="org.apache.tomcat" level="WARN"/>

    <!-- ============================================ -->
    <!-- ROOT LOGGER - Configuration by Profile -->
    <!-- ============================================ -->
    
    <!-- DEV Profile: Console + JSON logs -->
    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_JSON"/>
            <appender-ref ref="ASYNC_ERROR"/>
        </root>
    </springProfile>

    <!-- TEST Profile: Console only -->
    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <!-- Menos verbose en tests -->
        <logger name="org.hibernate.SQL" level="INFO"/>
        <logger name="org.springframework.web" level="INFO"/>
    </springProfile>
    
    <!-- PROD Profile: JSON logs only (sin console) -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>  <!-- Temporal para debugging -->
            <appender-ref ref="ASYNC_JSON"/>
            <appender-ref ref="ASYNC_ERROR"/>
        </root>
        <!-- Menos verbose en producción -->
        <logger name="org.hibernate.SQL" level="WARN"/>
        <!-- DEBUG temporal para autenticación -->
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.springframework.security" level="DEBUG"/>
        <logger name="com.techmate.techmate" level="INFO"/>
        <logger name="com.techmate.techmate.security" level="DEBUG"/>
    </springProfile>
    
    <!-- Default (no profile): Console + JSON -->
    <springProfile name="!dev &amp; !test &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_JSON"/>
            <appender-ref ref="ASYNC_ERROR"/>
        </root>
    </springProfile>

</configuration>
